{
  "backend": {
    "name": "existing-pipeline",
    "transcriber": "openai",
    "transcription_model": "gpt-transcribe",
    "fallback_transcriber": "openai",
    "fallback_transcription_model": "gpt-transcribe",
    "language": "ja",
    "transcription_workers": 4
  },
  "audio": {
    "track": 1
  },
  "workflow": {
    "mode": "long-stream"
  },
  "alignment": {
    "max_split_depth": 4,
    "offline_model_cache": false
  },
  "cleanup": {
    "backend": "openai",
    "api_model": "gpt-5.6-luna",
    "reasoning_effort": "low",
    "window_subtitles": 256,
    "workers": 8,
    "skip_final_review": false,
    "llm_split_planning": true
  },
  "editorial": {
    "analysis_model": "gpt-5.6-luna",
    "reasoning_effort": "medium",
    "visual_sampling_scale": 1.5,
    "director_model": "gpt-5.6-terra",
    "director_reasoning_effort": "low",
    "subtitle_cleanup_model": "gpt-5.6-luna",
    "subtitle_cleanup_reasoning_effort": "low"
  },
  "subtitles": {
    "chain_split_workers": 6
  },
  "diagnostics": {
    "profile": true,
    "llm_split_diagnostics": true
  },
  "additional_settings": {
    "youtube_chapters": false,
    "cut_silence_mode": "off",
    "render_cut_video": false
  }
}
